# ============================================================
# Variaveis de Ambiente - DESENVOLVIMENTO
# Copie para .env (e/ou .env.dev) e ajuste os valores.
# NUNCA versione o .env real com senhas verdadeiras.
# ============================================================

COMPOSE_PROJECT_NAME=hotspot-dev

# --- Dominios ---
DOMAIN_HOTSPOT=localhost
VITE_API_URL=localhost
DOMAIN_EVOLUTION=evolution.localhost

# --- Backend ---
PORT=3001
NODE_ENV=development
JWT_SECRET=TROQUE_gerar_com_openssl_rand_-base64_48
SYSTEM_DOMAIN=127.0.0.1

# --- Banco de dados (DB_* -> usados pelo db.js e mapeados pelo docker-compose para o MySQL) ---
DB_HOST=127.0.0.1
DB_USER=hotspotuser
DB_PASSWORD=TROQUE_senha_dev
DB_NAME=hotspot
MYSQL_ROOT_PASSWORD=TROQUE_senha_root_dev

# --- Evolution API ---
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=TROQUE_evo_api_key
EVOLUTION_INSTANCE=hotspot
EVO_API_KEY=TROQUE_evo_api_key

# --- PostgreSQL (Evolution) ---
POSTGRES_USER=evolution
POSTGRES_PASSWORD=TROQUE_senha_postgres_dev
POSTGRES_DB=evolution_db

# --- WireGuard ---
# PASSWORD_HASH: gerar com `docker run --rm ghcr.io/wg-easy/wg-easy wgpw 'SUA_SENHA'`
# e dobrar todo "$" para "$$" (exigencia do Docker Compose - ver docs/COOLIFY-DEPLOY.md)
WG_HOST=SEU_IP_LAN_OU_PUBLICO
WG_PASS=TROQUE_senha_painel_wg
PASSWORD_HASH=$$SUBSTITUA$$PELO$$HASH$$GERADO
WG_PANEL_PORT=51950
WG_VPN_PORT=13231

# --- Imagens ---
REGISTRY=hotspot
IMAGE_TAG=dev

# ============================================================
# PORTAS EXPOSTAS NO HOST (dev)
# Ajuste aqui se alguma porta ja estiver em uso no seu PC
# ============================================================
BACKEND_HOST_PORT=3001
FRONTEND_HOST_PORT=3000
NGINX_HOST_PORT=8090
EVO_HOST_PORT=8091
MYSQL_HOST_PORT=3306
POSTGRES_HOST_PORT=5432
