# Copie para wg-password.env (raiz do projeto, ao lado do docker-compose.prod.yml)
# Usado pelo stack Traefik/Portainer/Swarm (docker-compose.prod.yml), via
# env_file no servico wg-easy. NUNCA versionar o arquivo real.
#
# PASSWORD_HASH = hash bcrypt da senha do painel wg-easy, com TODO "$" dobrado
# para "$$" (exigencia do Docker Compose - ver docs/COOLIFY-DEPLOY.md).
# Gerar com: docker run --rm ghcr.io/wg-easy/wg-easy wgpw 'SUA_SENHA'
PASSWORD_HASH=$$SUBSTITUA$$PELO$$HASH$$GERADO
