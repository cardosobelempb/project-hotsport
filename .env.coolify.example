# ============================================================
# Variaveis de ambiente - deploy via Coolify
# NAO commitar com valores reais. Cadastrar cada uma dessas chaves
# na aba "Environment Variables" do recurso Docker Compose no Coolify.
# ============================================================

# --- Dominio (so para referencia/documentacao - o dominio de fato e
# configurado por servico na UI do Coolify, ver docs/COOLIFY-DEPLOY.md) ---
SYSTEM_DOMAIN=hotspot.seudominio.com.br

# --- Backend ---
JWT_SECRET=GERAR_COM_openssl_rand_-base64_48
UPDATE_SERVER_URL=https://glpi.forumtelecom.com.br

# --- Banco MySQL externo (nao sobe container MySQL neste stack) ---
DB_HOST=SEU_HOST_MYSQL
DB_PORT=3306
DB_USER=hotspotuser
DB_PASSWORD=SENHA_FORTE_AQUI
DB_NAME=hotspot

# --- Evolution API externa (WhatsApp - opcional) ---
EVOLUTION_API_URL=https://sua-evolution.seudominio.com.br
EVOLUTION_API_KEY=SUA_API_KEY
EVOLUTION_INSTANCE=hotspot

# --- WireGuard / wg-easy ---
# WG_HOST      -> IP publico ou dominio da VPS (endpoint gravado no config dos peers)
# WG_PASS      -> senha em texto puro do painel wg-easy (usada pelo backend p/ autenticar na API)
# WG_PASS_HASH -> hash bcrypt da mesma senha (usada pelo container wg-easy)
#                 gerar com: docker run --rm ghcr.io/wg-easy/wg-easy wgpw 'SUA_SENHA'
#                 IMPORTANTE: dobre TODO "$" do hash para "$$" ao colar esse
#                 valor na UI do Coolify (mesma exigencia do wg-password.env
#                 do stack Portainer/Swarm) - o Coolify interpola a variavel
#                 dentro do docker-compose.coolify.yml, e um "$" simples no
#                 meio do hash e' lido como inicio de outra variavel, quebrando
#                 a senha (sintoma: warning "variable is not set" no log de
#                 build e login do painel wg-easy falhando).
#                 Exemplo: hash gerado "$2a$12$RMEf...cmRUA6" vira
#                          "$$2a$$12$$RMEf...cmRUA6" no valor da variavel.
# WG_PANEL_PORT -> porta TCP do painel wg-easy (padrao: 51950)
# WG_VPN_PORT   -> porta UDP do WireGuard (padrao: 51820)
WG_HOST=SEU_IP_PUBLICO
WG_PASS=SENHA_DO_PAINEL
WG_PASS_HASH=$$2a$$12$$SUBSTITUA_PELO_HASH_GERADO
WG_PANEL_PORT=51950
WG_VPN_PORT=51820

# --- FreeRADIUS (portas UDP publicadas direto no host, fora do proxy) ---
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_COA_PORT=3799
