# ============================================================
# Variaveis de Ambiente - PRODUCAO (stack Traefik/Portainer/Swarm)
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# Copie para .env.prod e ajuste os valores.
# NUNCA versione este arquivo com senhas reais!
# ============================================================

COMPOSE_PROJECT_NAME=hotspot

# --- Dominio ---
APP_DOMAIN=hotspot.seudominio.com.br
SYSTEM_DOMAIN=hotspot.seudominio.com.br

# --- Backend ---
PORT=3001
NODE_ENV=production
JWT_SECRET=TROQUE_gerar_com_openssl_rand_-base64_48
UPDATE_SERVER_URL=https://glpi.forumtelecom.com.br

# --- Banco MySQL externo ---
# Nao sobe container MySQL em producao. Aponte para o banco ja existente.
DB_HOST=SEU_HOST_MYSQL
DB_PORT=3306
DB_USER=hotspotuser
DB_PASSWORD=TROQUE_senha_forte
DB_NAME=hotspot

# --- Evolution API externa ---
# Nao sobe PostgreSQL nem Evolution em producao. Aponte para sua Evolution existente.
EVOLUTION_API_URL=https://sua-evolution.seudominio.com.br
EVOLUTION_API_KEY=TROQUE_evo_api_key
EVOLUTION_INSTANCE=hotspot

# --- WireGuard / wg-easy ---
# WG_EASY_HOST  -> hostname do servico wg-easy na rede Docker (padrao: wg-easy)
# WG_HOST       -> IP publico / dominio da VPS para montar o endpoint dos peers
# WG_PASS       -> senha plaintext do painel wg-easy (usado pelo backend)
# WG_PASS_HASH  -> hash bcrypt da senha, usado apenas dentro do wg-password.env
#                   (NAO cadastrar aqui - ver wg-password.env.example)
#                   gerar com: docker run --rm ghcr.io/wg-easy/wg-easy wgpw 'SUA_SENHA'
# WG_PANEL_PORT -> porta TCP do painel wg-easy (padrao: 51821)
# WG_VPN_PORT   -> porta UDP do WireGuard (padrao: 51820)
WG_EASY_HOST=wg-easy
WG_HOST=SEU_IP_PUBLICO
WG_PASS=TROQUE_senha_painel_wg
WG_PANEL_PORT=51950
WG_VPN_PORT=13231

# --- FreeRADIUS ---
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_COA_PORT=3799

# --- Imagens para Portainer/Swarm ---
# Pode usar registry publico ou imagem local importada no VPS.
BACKEND_IMAGE=seuregistro/backend:production
FRONTEND_IMAGE=seuregistro/frontend:production
FREERADIUS_IMAGE=seuregistro/freeradius:production

# --- Build/Push pelo hotspot.bat ---
REGISTRY=seuregistro
IMAGE_TAG=production
